<%# This template is rendered inside app/views/layouts/mailer.html.erb %>
<div style="width: 100%; background-color: #f5f5f3; padding: 48px 0;">
  <div style="max-width: 520px; margin: 0 auto; background-color: #ffffff; padding: 48px 48px 40px; font-family: Georgia, 'Times New Roman', Times, serif; color: #1a1a1a;">

    <!-- Header -->
    <div style="border-bottom: 1px solid #1a1a1a; padding-bottom: 20px; margin-bottom: 36px;">
      <p style="margin: 0; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: #1a1a1a;">Digital Training Log</p>
    </div>

    <!-- Content -->
    <div>
      <p style="margin: 0 0 20px; font-size: 16px; line-height: 1.6; color: #1a1a1a;">Hi <%= @user.name %>,</p>
      <p style="margin: 0 0 20px; font-size: 16px; line-height: 1.6; color: #1a1a1a;">Thanks for creating an account. Activate it using the button below to get started.</p>

      <!-- CTA -->
      <div style="margin: 36px 0;">
        <a href="<%= @activation_url %>"
           style="display: inline-block; background-color: #1a1a1a; color: #ffffff; text-decoration: none; font-family: Georgia, 'Times New Roman', Times, serif; font-size: 13px; letter-spacing: 0.08em; padding: 14px 28px;"
           target="_blank">
          Activate Account
        </a>
      </div>

      <p style="margin: 0; font-size: 16px; line-height: 1.6; color: #1a1a1a;">This link expires in 24 hours.</p>
    </div>

    <!-- Footer -->
    <div style="border-top: 1px solid #e0e0e0; margin-top: 40px; padding-top: 20px;">
      <p style="margin: 0; font-size: 12px; line-height: 1.6; color: #6b6b6b;">If you didn't create a Digital Training Log account, you can safely ignore this email.</p>
      <p style="margin-top: 20px; font-size: 12px; line-height: 1.5; color: #6b6b6b; word-break: break-all;">
        If the button above doesn't work, copy and paste this URL into your browser:<br />
        <a href="<%= @activation_url %>" style="color: #6b6b6b;"><%= @activation_url %></a>
      </p>
    </div>

  </div>
</div>
