<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Reset your password</title>
<style>
  /* Most clients strip <style>, so critical rules are also inlined below.
     This block only handles things that can't be inlined (media queries, font-face). */
  @media only screen and (max-width: 600px) {
    .container { width: 100% !important; }
    .px { padding-left: 24px !important; padding-right: 24px !important; }
    .py { padding-top: 32px !important; padding-bottom: 32px !important; }
  }
</style>
</head>
<body style="margin:0; padding:0; background-color:#F7F1E8; font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;">
  <!-- preheader (hidden preview text) -->
  <div style="display:none; max-height:0; overflow:hidden; opacity:0;">
    Reset your Digital Training Log password. This link expires in <%= @expires_in_words %>.
  </div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#F7F1E8;">
    <tr>
      <td align="center" style="padding: 48px 16px;">
        <table role="presentation" class="container" width="600" cellpadding="0" cellspacing="0" style="width:600px; max-width:600px; background-color:#FFFDF9; border:1px solid #E4D9C7;">

          <!-- Header / wordmark -->
          <tr>
            <td class="px py" style="padding: 40px 48px 0 48px;">
              <span style="font-family: 'Playfair Display', Georgia, 'Times New Roman', serif; font-size: 20px; color:#3A2E22; letter-spacing: 0.02em;">
                Digital Training Log
              </span>
            </td>
          </tr>

          <!-- Divider -->
          <tr>
            <td style="padding: 24px 48px 0 48px;">
              <div style="border-top: 1px solid #E4D9C7;"></div>
            </td>
          </tr>

          <!-- Heading -->
          <tr>
            <td class="px" style="padding: 32px 48px 0 48px;">
              <h1 style="margin:0; font-family: 'Playfair Display', Georgia, 'Times New Roman', serif; font-weight: 500; font-size: 28px; line-height: 1.3; color:#241C14;">
                Reset your password
              </h1>
            </td>
          </tr>

          <!-- Body copy -->
          <tr>
            <td class="px" style="padding: 16px 48px 0 48px;">
              <p style="margin:0 0 16px 0; font-size: 16px; line-height: 1.6; color:#544435;">
                Hi <%= @user.name.presence || "there" %>,
              </p>
              <p style="margin:0 0 16px 0; font-size: 16px; line-height: 1.6; color:#544435;">
                We received a request to reset the password for your Digital Training Log account. Click the button below to choose a new one.
              </p>
            </td>
          </tr>

          <!-- CTA button -->
          <tr>
            <td class="px" align="left" style="padding: 24px 48px 0 48px;">
              <table role="presentation" cellpadding="0" cellspacing="0">
                <tr>
                  <td style="background-color:#B5502E;">
                    <a href="<%= @reset_url %>"
                       style="display:inline-block; padding: 14px 32px; font-family: 'DM Sans', sans-serif; font-size: 15px; font-weight: 600; color:#FFFDF9; text-decoration:none; letter-spacing: 0.01em;">
                      Reset Password
                    </a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Expiry note -->
          <tr>
            <td class="px" style="padding: 24px 48px 0 48px;">
              <p style="margin:0 0 16px 0; font-size: 14px; line-height: 1.6; color:#7A6A57;">
                This link expires in 2 hours. If it's expired, you can request a new one from the sign-in page.
              </p>
              <p style="margin:0 0 16px 0; font-size: 14px; line-height: 1.6; color:#7A6A57;">
                If you didn't request this, you can safely ignore this email — your password won't be changed.
              </p>
            </td>
          </tr>

          <!-- Fallback link -->
          <tr>
            <td class="px" style="padding: 8px 48px 0 48px;">
              <p style="margin:0 0 4px 0; font-size: 13px; color:#9C8D79;">
                Or paste this link into your browser:
              </p>
              <p style="margin:0; font-size: 13px; word-break: break-all;">
                <a href="<%= @reset_url %>" style="color:#B5502E; text-decoration: underline;"><%= @reset_url %></a>
              </p>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="padding: 40px 48px 40px 48px;">
              <div style="border-top: 1px solid #E4D9C7; padding-top: 24px;">
                <p style="margin:0; font-size: 12px; color:#9C8D79; line-height: 1.6;">
                  Digital Training Log &middot; This is an automated message, please don't reply directly to this email.
                </p>
              </div>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
