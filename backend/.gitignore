# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development)
/storage/*
!/storage/.keep
/public/uploads

# Ignore master key for decrypting credentials.
/config/master.key

# Ignore database-specific files (if using SQLite for dev)
/*.sqlite3
/*.sqlite3-journal
/*.sqlite3-[0-9]*

# Ignore node_modules if you added any JS tools to the backend
node_modules/

# Ignore deployment-specific secrets (Kamal/Docker)
.kamal/secrets
.dockerignore